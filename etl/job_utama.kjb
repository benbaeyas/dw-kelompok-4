    <entry>
      <name>SQL kosongkan fakta dan dimensi</name>
      <description>Hanya mengosongkan fakta dan dimensi Tipe 1. dim_sales_person (SCD Tipe 2) dipertahankan.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE FROM fact_kinerja_sales_v2;
DELETE FROM dim_produk WHERE produk_key NOT IN (-1, -2);
DELETE FROM dim_wilayah WHERE wilayah_key &lt;&gt; -1;
ALTER TABLE dim_produk AUTO_INCREMENT = 1;
ALTER TABLE dim_wilayah AUTO_INCREMENT = 1;
</sql>
