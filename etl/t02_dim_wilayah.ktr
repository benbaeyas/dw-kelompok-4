      <from>in_dim_wilayah</from>
      <to>out_dim_wilayah</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>in_dim_wilayah</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>adn_kl4-v2</connection>
    <sql>SELECT t.territoryid                          AS territory_id,
       t.name                                 AS nama_wilayah,
       COALESCE(t.countryregioncode, 'N/A')   AS kode_negara,
       COALESCE(c.name, 'Tidak diketahui')    AS nama_negara,
       COALESCE(t.grup, 'Tidak diketahui')    AS grup_wilayah,
       CASE WHEN EXISTS (SELECT 1 FROM stg_salesperson sp
                         WHERE sp.territoryid = t.territoryid)
              OR EXISTS (SELECT 1 FROM stg_salesterritoryhistory h
                         WHERE h.territoryid = t.territoryid AND h.enddate IS NULL)
            THEN 1 ELSE 0 END                 AS is_active
FROM stg_salesterritory t
LEFT JOIN stg_countryregion c ON c.countryregioncode = t.countryregioncode
ORDER BY t.territoryid</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
      <input />
      <output />
    </remotesteps>
    <GUI>
      <xloc>140</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>out_dim_wilayah</name>
    <type>TableOutput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
